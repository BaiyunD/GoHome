public float CalculateDamage(float baseDamage, float defense, bool isCritical, float elementalBonus, int comboCount)
{
    float comboBonus = 1f + (comboCount * 0.05f);  // 每连击+5%
    float criticalMultiplier = isCritical ? 1.5f : 1f;
    float defenseReduction = defense / 100f + 1f;
    return baseDamage * criticalMultiplier * elementalBonus * comboBonus / defenseReduction;
}
